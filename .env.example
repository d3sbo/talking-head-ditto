# Copy to .env and fill in. docker compose reads this automatically.

# ── Home Assistant ────────────────────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token
HA_NOTIFY_SERVICE=notify.mobile_app_your_phone

# ── XTTS v2 (tts_server, port 5051) ───────────────────────────────────────────
XTTS_URL=http://your-tts-host:5051
TTS_VOICE=en-GB-RyanNeural
XTTS_TEMPO=1.0

# ── Voicebox (port 17493) ─────────────────────────────────────────────────────
VOICEBOX_URL=http://your-tts-host:17493
VOICEBOX_PROFILE=YourProfileName
# Engine: qwen (Base clone) | tada (Hume TADA 1B, stronger prosody)
VOICEBOX_ENGINE=qwen
VOICEBOX_MAX_CHUNK=800
# Pitch-preserving time-stretch of the finished audio. 1.0 = off
VOICEBOX_TEMPO=1.0
